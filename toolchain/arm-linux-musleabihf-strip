#!/bin/sh
# ABOUTME: Cross strip shim. zig cc already links stripped binaries (no -g), and neither
# ABOUTME: `zig objcopy --strip-all` nor host binutils strip handle static ARM ELF, so copy.
out=""; in=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -*) shift ;;
    *) in="$1"; shift ;;
  esac
done
[ -n "$in" ] || { echo "arm strip shim: no input file" >&2; exit 1; }
[ -z "$out" ] || [ "$out" = "$in" ] || cp "$in" "$out"
